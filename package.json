{
  "name": "ascandir-interactivemap",
  "productName": "Ascandir InteractiveMap",
  "version": "0.20.0",
  "description": "Interaktive Karte für Star Wars und eigene Welten – mit Zeitaltern, Fraktionen und eigenen Zeitlinien",
  "main": "main.js",
  "author": "Ascandir",
  "license": "UNLICENSED",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win nsis --x64 --publish never"
  },
  "devDependencies": {
    "electron": "^45.0.0",
    "electron-builder": "^26.0.0"
  },
  "build": {
    "appId": "de.ascandir.swgm",
    "productName": "Ascandir InteractiveMap",
    "files": [
      "main.js",
      "preload.js",
      "src/**/*",
      "build/icon.png"
    ],
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": "nsis",
      "icon": "build/icon.png",
      "artifactName": "Ascandir-InteractiveMap-Setup-${version}.exe"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Ascandir InteractiveMap",
      "deleteAppDataOnUninstall": false,
      "language": "1031",
      "include": "build/installer.nsh"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "Ascandir",
        "repo": "Ascandir---SWGM",
        "releaseType": "release"
      }
    ]
  },
  "dependencies": {
    "electron-updater": "^6.8.11"
  }
}
